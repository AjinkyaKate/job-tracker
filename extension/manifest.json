{
  "manifest_version": 3,
  "name": "Job Tracker Capture",
  "version": "0.1.0",
  "description": "Capture any job posting from any site to your Job Tracker in one click.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:8001/*",
    "https://job-tracker-bmhy.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture this job"
  }
}
