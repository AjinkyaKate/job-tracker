# Copy this file to .env and fill in your own values.
# Never commit .env — it's gitignored for a reason.

# ─── HTTP Basic Auth (gates the whole web app) ───────────────────────────────
# Pick anything. These guard your personal job data from the open internet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long-and-random

# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev: leave blank → uses SQLite at ./tracker.db (gitignored)
# Production (Render / Heroku / Railway): set this to your Postgres URL.
# Example: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# ─── Gmail OAuth (for the Leads-inbox ingestion + status auto-advance) ──────
# Follow GMAIL_SETUP.md to create a Google Cloud OAuth app.
# Without these, the Gmail features are disabled but the rest of the app
# still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/gmail/callback
# In production, GOOGLE_REDIRECT_URI must match what you registered in the
# Google Cloud OAuth consent screen (e.g. https://your-app.onrender.com/auth/gmail/callback).

# ─── Gemini API (powers email classification + Resume Studio) ───────────────
# Get a key from https://aistudio.google.com/. Free tier is 30 RPM / 1500 req-day.
# Without this, the LLM-powered features fall back to regex-only matching.
GEMINI_API_KEY=

# ─── Optional: Anthropic Claude (if you want to swap from Gemini later) ─────
# Get a key from https://console.anthropic.com/. Code currently uses Gemini
# as the default. Switching is a small edit in llm_helpers.py.
ANTHROPIC_API_KEY=

# ─── Port (PaaS hosts inject this; leave blank locally) ─────────────────────
PORT=
